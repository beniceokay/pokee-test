# Copy to .env in your project dir — or to ~/.pokee/.env to set it once
# globally. Exporting POKEE_API_KEY in your shell also works and wins.
# Key comes from developer.pokee.ai -> API Keys -> Create Key (shown once).
POKEE_API_KEY=pk-live-xxxxx

# Optional overrides
# POKEE_API_URL=https://api.pokee.ai/v1/chat/completions
# POKEE_MODEL=pokee-isaac
# ISAAC_PROXY_PORT=8787
